# Dependencies — will be reinstalled inside container
node_modules/
npm-debug.log*

# Environment secrets — NEVER in an image
.env
.env.*
.env.local
.env.production

# Version control
.git/
.gitignore

# Seeds — dangerous in production (handled in Dockerfile too, belt + suspenders)
seeds/

# OS artifacts
.DS_Store
Thumbs.db

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo

# Documentation (not needed at runtime)
*.md
README*

# Test artifacts
coverage/
.nyc_output/